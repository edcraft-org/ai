    "def clamp_score(score):",
    "    if score < 0:",
    "        return 0",
    "    if score > 100:",
    "        return 100",
    "    return score",
    "",
    "def weighted_total(scores, weights):",
    "    total = 0",
    "    for index in range(len(scores)):",
    "        score = clamp_score(scores[index])",
    "        total += score * weights[index]",
    "    return round(total, 2)"
