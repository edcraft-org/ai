# Copy this file to .env for local development. Never commit .env.
# Select fake, ollama, soclaas, or another OpenAI-compatible provider.
GENERATION_PROVIDER=ollama
GENERATION_MODEL=

# Ollama does not require a real key; the client uses a local placeholder.
OLLAMA_API_KEY=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5-coder:14b

# SoC LaaS / OpenAI-compatible settings remain available for toggling.
SOCLAAS_API_KEY=
SOCLAAS_BASE_URL=https://soclaas-api.comp.nus.edu.sg/v1
SOCLAAS_MODEL=

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
SOCLAAS_API_KEY="<your_api_key>"
SOCLAAS_BASE_URL="https://soclaas-api.comp.nus.edu.sg/v1"
