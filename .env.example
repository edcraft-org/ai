OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT_SECONDS=120
OPENAI_MAX_RETRIES=1
OPENAI_RESPONSE_FORMAT=json_schema
# For a custom OpenAI-compatible endpoint, set OPENAI_BASE_URL and OPENAI_MODEL.
# Use json_object above if the endpoint lacks strict JSON schema support.
# Optional overrides; omit these to use endpoint defaults:
# OPENAI_GENERATION_MAX_TOKENS=16384
# OPENAI_REASONING_EFFORT=medium

# One model for difficulty classification, reasoning fallback and relevance.
# Decisions disable reasoning; only the difficulty fallback uses this effort.
EDCRAFT_JUDGE_PROVIDER=soclaas
EDCRAFT_JUDGE_MODEL=x-test-3
EDCRAFT_JUDGE_REASONING_EFFORT=medium
# Development-selected x-test-3 cutoff; recalibrate when changing the model.
EDCRAFT_RELEVANCE_THRESHOLD=0.9223792980579683

# Optional legacy local reranker for reproducing earlier evaluations.
EDCRAFT_RELEVANCE_MODEL_PATH=

OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_TEMPERATURE=0
OLLAMA_NUM_PREDICT=2048
OLLAMA_THINK=false

SOCLAAS_API_KEY=
SOCLAAS_BASE_URL=https://soclaas-api.comp.nus.edu.sg/v1
SOCLAAS_MODEL=x-test-1
SOCLAAS_TIMEOUT_SECONDS=300
SOCLAAS_MAX_RETRIES=1
SOCLAAS_RESPONSE_FORMAT=json_schema
SOCLAAS_REASONING_EFFORT=default
SOCLAAS_GENERATION_MAX_TOKENS=16384
